      "notes": "save/sync state"
    },
    "NotificationList": {
      "use": "NotificationList",
      "import": "import { NotificationList } from \"@/components/opc/notification-list\"",
      "custom": true,
      "notes": "notification centre"
    },
    "Notification": {
      "use": "Notification",
      "import": "import { Notification } from \"@/components/opc/notification\"",
