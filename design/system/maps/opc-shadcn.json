{
  "library": "shadcn/ui (OPC extension)",
  "platform": "web-react",
  "docs": "https://ui.shadcn.com/docs/components",
  "extends": "references/component-maps/shadcn.json",
  "components": {
    "Button": {
      "use": "Button",
      "import": "import { Button } from \"@/components/ui/button\"",
      "variants": {
        "_default": {
          "variant": "outline"
        },
        "act": {
          "variant": "default",
          "note": "sea --act (primary action, current place); ONE per view"
        },
        "quiet": {
          "variant": "outline",
          "className": "border-line-quiet"
        },
        "danger": {
          "variant": "outline",
          "className": "text-err border-err"
        },
        "wrap": {
          "variant": "outline",
          "className": "h-auto whitespace-normal text-left font-body font-medium"
        },
        "block": {
          "className": "w-full"
        },
        "xl": {
          "size": "lg",
          "className": "h-16 rounded-2xl text-lg"
        }
      },
      "states": {
        "disabled": {
          "disabled": true,
          "note": "dashed border, never opacity only"
        },
        "aria-busy": {
          "disabled": true,
          "note": "spinner after label"
        }
      },
      "parts": {
        "icon": "lucide icon child",
        "kbd": "<Kbd> child"
      },
      "notes": "add variant act to buttonVariants (cva); min-h from --target via theme"
    },
    "IconButton": {
      "use": "Button size=icon",
      "import": "import { Button } from \"@/components/ui/button\"",
      "variants": {
        "outline": {
          "variant": "outline"
        },
        "_default": {
          "variant": "ghost"
        }
      },
      "parts": {
        "badge": "absolute count badge (aria-hidden; count in aria-label)"
      }
    },
    "Icon": {
      "use": "lucide-react icon",
      "import": "import { House, Store, ReceiptText, … } from \"lucide-react\"",
      "notes": "sprite ids map 1:1 to lucide icons; strokeWidth 2.4, square caps; size 22/18/26",
      "variants": {
        "s": {
          "size": 18
        },
        "l": {
          "size": 26
        },
        "_default": {
          "size": 22
        }
      }
    },
    "Kbd": {
      "use": "Kbd",
      "import": "import { Kbd } from \"@/components/ui/kbd\"",
      "notes": "shadcn Kbd (2025) or a <kbd> with tokens"
    },
    "SearchField": {
      "use": "Input with leading icon",
      "import": "import { Input } from \"@/components/ui/input\"",
      "variants": {
        "strong": {
          "className": "border-line-strong"
        }
      },
      "parts": {
        "input": "Input type=search"
      }
    },
    "Card": {
      "use": "Card",
      "import": "import { Card } from \"@/components/ui/card\"",
      "variants": {
        "tight": {
          "className": "p-4"
        }
      },
      "parts": {
        "head": "CardHeader (flex, baseline)",
        "title": "CardTitle (with 12px ink square)"
      }
    },
    "Table": {
      "use": "Table",
      "import": "import { Table } from \"@/components/ui/table\"",
      "variants": {
        "stack": {
          "note": "below 720px render rows as 2-line items (cell roles main/end/wide/hide)"
        },
        "row--err": {
          "className": "bg-destructive/5 [&>td:first-child]:shadow-[inset_3px_0_0_var(--destructive)]",
          "note": "row needing the owner whose sign is err; also derive from status"
        },
        "zero": {
          "className": "text-muted-foreground font-normal",
          "note": "\"0 ₫\" for no balance, never \"—\""
        }
      },
      "parts": {
        "scroll": "overflow-x-auto wrapper",
        "num": "TableCell text-right",
        "code": "TableCell font-display"
      }
    },
    "Switch": {
      "use": "Switch + Label",
      "import": "import { Switch } from \"@/components/ui/switch\"\nimport { Label } from \"@/components/ui/label\"",
      "states": {
        "aria-checked": {
          "checked": true
        },
        "disabled": {
          "disabled": true
        }
      },
      "variants": {
        "row": {
          "note": "settings row: Label left, state Badge (Bật / Tắt / Bắt buộc / Sắp có); lock = disabled; soon = Badge only, no Switch"
        }
      }
    },
    "SegmentedChoice": {
      "use": "ToggleGroup type=single",
      "import": "import { ToggleGroup } from \"@/components/ui/toggle-group\"",
      "notes": "role radiogroup semantics; selected = ink fill"
    },
    "FilterBar": {
      "use": "ToggleGroup type=multiple or single",
      "import": "import { ToggleGroup } from \"@/components/ui/toggle-group\"",
      "notes": "horizontal scroll on phone"
    },
    "FilterChip": {
      "use": "ToggleGroupItem",
      "import": "import { ToggleGroup } from \"@/components/ui/toggle-group\"",
      "states": {
        "aria-pressed": {
          "data-state": "on"
        }
      }
    },
    "ThresholdMeter": {
      "use": "Progress + marker",
      "import": "import { Progress } from \"@/components/ui/progress\"",
      "notes": "add the 1 tỷ marker as an absolutely positioned child",
      "variants": {
        "quiet": {
          "className": "h-1.5 [&>div]:bg-ink-3",
          "note": "neutral fill + warning line below (crossing 1 tỷ is not a goal)"
        }
      }
    },
    "HouseholdSwitcher": {
      "use": "DropdownMenu trigger",
      "import": "import { DropdownMenu } from \"@/components/ui/dropdown-menu\"",
      "variants": {
        "bar": {
          "note": "phone header version"
        }
      }
    },
    "AccountButton": {
      "use": "DropdownMenu trigger + Avatar",
      "import": "import { Avatar, AvatarFallback } from \"@/components/ui/avatar\""
    },
    "Picker": {
      "use": "Button opening Command in Dialog/Drawer",
      "import": "import { Command } from \"@/components/ui/command\"",
      "notes": "customer search by name / MST"
    },
    "SidebarNav": {
      "use": "Sidebar",
      "import": "import { Sidebar, SidebarMenu, SidebarMenuItem, SidebarMenuButton, SidebarMenuSub, SidebarMenuSubItem, SidebarMenuSubButton, SidebarMenuBadge, SidebarMenuAction } from \"@/components/ui/sidebar\"; import { Collapsible, CollapsibleTrigger, CollapsibleContent } from \"@/components/ui/collapsible\"",
      "parts": {
        "item--counter": "SidebarMenuButton with outline, trailing arrow",
        "count": "SidebarMenuBadge (on the child that owns the work; summed on a collapsed parent)",
        "grp": "Collapsible > SidebarMenuItem (open = route is inside the section)",
        "peek": "SidebarMenuAction asChild > CollapsibleTrigger (44px, aria-expanded)",
        "sub": "CollapsibleContent > SidebarMenuSub",
        "subitem": "SidebarMenuSubButton asChild > Link (isActive = aria-current)",
        "item--here": "SidebarMenuButton isActive={false} font-semibold (section of current page)",
        "list--foot": "SidebarFooter"
      },
      "notes": "Tree from one NAV config filtered by business model (features) and role; same config renders the phone \"Thêm\" sheet (variant sheet: all open, no peek). Hide SectionNav ≥721px.",
      "variants": {
        "sheet": {
          "note": "Drawer on phone; every section open, no disclosure buttons"
        }
      }
    },
    "BrandMark": {
      "use": "BrandMark",
      "import": "import { BrandMark } from \"@/components/opc/brand-mark\"",
      "custom": true,
      "notes": "OPC mark + by QNSC"
    },
    "ConnectionStatus": {
      "use": "ConnectionStatus",
      "import": "import { ConnectionStatus } from \"@/components/opc/connection-status\"",
      "custom": true,
      "notes": "dot + words; off = hollow, err = red"
    },
    "OwnerSentence": {
      "use": "OwnerSentence",
      "import": "import { OwnerSentence } from \"@/components/opc/owner-sentence\"",
      "custom": true,
      "notes": "plain sentence above a figure"
    },
    "StatusSign": {
      "use": "StatusSign",
      "import": "import { StatusSign } from \"@/components/opc/status-sign\"",
      "custom": true,
      "notes": "pictogram + word; variants wait/pend/ok/you/err/unk; build on Badge if wanted"
    },
    "MoneyLine": {
      "use": "MoneyLine",
      "import": "import { MoneyLine } from \"@/components/opc/money-line\"",
      "custom": true,
      "notes": "3 squares, data-step 1–3, role=img + aria-label"
    },
    "LedgerList": {
      "use": "LedgerList",
      "import": "import { LedgerList } from \"@/components/opc/ledger-list\"",
      "custom": true,
      "notes": "hairline rows"
    },
    "QuantityStepper": {
      "use": "QuantityStepper",
      "import": "import { QuantityStepper } from \"@/components/opc/quantity-stepper\"",
      "custom": true,
      "notes": "spinbutton semantics; −/value/+"
    },
    "QrPayment": {
      "use": "QrPayment",
      "import": "import { QrPayment } from \"@/components/opc/qr-payment\"",
      "custom": true,
      "notes": "VietQR + aria-live status"
    },
    "MoneyConfirm": {
      "use": "MoneyConfirm",
      "import": "import { MoneyConfirm } from \"@/components/opc/money-confirm\"",
      "custom": true,
      "notes": "locked until bank reports (aria-disabled + reason); --done"
    },
    "PhoneTabBar": {
      "use": "PhoneTabBar",
      "import": "import { PhoneTabBar } from \"@/components/opc/phone-tab-bar\"",
      "custom": true,
      "notes": "fixed bottom nav ≤720px"
    },
    "AppShell": {
      "use": "AppShell",
      "import": "import { AppShell } from \"@/components/opc/app-shell\"",
      "custom": true,
      "notes": "recipe: composition of the components it uses (registry.json → uses)"
    },
    "PageHeader": {
      "use": "PageHeader",
      "import": "import { PageHeader } from \"@/components/opc/page-header\"",
      "custom": true,
      "notes": "recipe: composition of the components it uses (registry.json → uses)"
    },
    "PhonePaymentSheet": {
      "use": "PhonePaymentSheet",
      "import": "import { PhonePaymentSheet } from \"@/components/opc/phone-payment-sheet\"",
      "custom": true,
      "notes": "recipe: composition of the components it uses (registry.json → uses)"
    },
    "Banner": {
      "use": "Alert",
      "import": "import { Alert, AlertTitle, AlertDescription } from \"@/components/ui/alert\"",
      "variants": {
        "err": {
          "variant": "destructive",
          "role": "alert"
        },
        "pend": {
          "className": "border-dashed border-pend bg-pend-soft"
        },
        "ok": {
          "className": "border-ok bg-ok-soft"
        }
      },
      "notes": "pictogram + title + body + actions; --err uses role=alert"
    },
    "StateTabs": {
      "use": "Tabs > TabsList > TabsTrigger",
      "import": "import { Tabs, TabsList, TabsTrigger } from \"@/components/ui/tabs\"",
      "variants": {
        "tab--you": {
          "note": "dark count badge"
        }
      },
      "notes": "count badge inside each trigger; horizontal scroll + edge fade on phone"
    },
    "Dialog": {
      "use": "Dialog (≥721px) / Drawer (≤720px)",
      "import": "import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogFooter } from \"@/components/ui/dialog\"\nimport { Drawer } from \"@/components/ui/drawer\"",
      "notes": "focus to title, trap, Esc, return focus; footer note = result preview; primary names the result"
    },
    "OptionList": {
      "use": "RadioGroup",
      "import": "import { RadioGroup } from \"@/components/ui/radio-group\""
    },
    "OptionCard": {
      "use": "RadioGroupItem rendered as a card (label wraps title/meta/why/amount)",
      "import": "import { RadioGroupItem } from \"@/components/ui/radio-group\"",
      "states": {
        "aria-checked": {
          "checked": true
        },
        "disabled": {
          "disabled": true
        }
      },
      "variants": {
        "big": {
          "note": "pictogram + bigger title"
        },
        "action": {
          "note": "no radio; a card that performs an action (render as Button/Link)"
        },
        "best": {
          "note": "the recommended choice + Badge 'Nên chọn'; alternatives in Collapsible 'Cách khác'"
        },
        "on": {
          "data-state": "checked",
          "note": "checkbox card in a multi-select group (r-model)"
        }
      }
    },
    "Field": {
      "use": "Label + Input (+ FormMessage)",
      "import": "import { Input } from \"@/components/ui/input\"\nimport { Label } from \"@/components/ui/label\"",
      "variants": {
        "money": {
          "inputMode": "numeric",
          "className": "text-right font-display text-amount-l"
        }
      },
      "states": {
        "data-invalid": {
          "aria-invalid": true
        }
      }
    },
    "EmptyState": {
      "use": "EmptyState",
      "import": "import { EmptyState } from \"@/components/opc/empty-state\"",
      "custom": true,
      "notes": "pic + title + body (+ one action)"
    },
    "ChangeDue": {
      "use": "ChangeDue",
      "import": "import { ChangeDue } from \"@/components/opc/change-due\"",
      "custom": true,
      "notes": "high-contrast change-due panel; --short = customer short of money"
    },
    "FactList": {
      "use": "FactList",
      "import": "import { FactList } from \"@/components/opc/fact-list\"",
      "custom": true,
      "notes": "<dl> of facts; raw bank strings verbatim"
    },
    "CodeInput": {
      "use": "InputOTP > InputOTPGroup > InputOTPSlot ×6",
      "import": "import { InputOTP, InputOTPGroup, InputOTPSlot } from \"@/components/ui/input-otp\"",
      "notes": "autocomplete one-time-code, paste fills all"
    },
    "Menu": {
      "use": "DropdownMenu (sort, DropdownMenuRadioGroup) / Command in Popover (search suggestions)",
      "import": "import { DropdownMenu } from \"@/components/ui/dropdown-menu\"\nimport { Command } from \"@/components/ui/command\""
    },
    "Calendar": {
      "use": "Calendar mode=\"range\" in Dialog/Drawer",
      "import": "import { Calendar } from \"@/components/ui/calendar\"",
      "notes": "locale vi, weekStartsOn 1, disable future"
    },
    "Pagination": {
      "use": "Pagination",
      "import": "import { Pagination } from \"@/components/ui/pagination\"",
      "notes": "compact (accountant) only; owners use load-more"
    },
    "FilterChipRemovable": {
      "use": "Badge + Button size=icon",
      "import": "import { Badge } from \"@/components/ui/badge\""
    },
    "StepProgress": {
      "use": "StepProgress",
      "import": "import { StepProgress } from \"@/components/opc/step-progress\"",
      "custom": true,
      "notes": "Bước n/6 + segments"
    },
    "AssistantAnswer": {
      "use": "AssistantAnswer",
      "import": "import { AssistantAnswer } from \"@/components/opc/assistant-answer\"",
      "custom": true,
      "notes": "automatic answer; aria-live; next to human help"
    },
    "CoachMark": {
      "use": "CoachMark",
      "import": "import { CoachMark } from \"@/components/opc/coach-mark\"",
      "custom": true,
      "notes": "guided first sale bubble; non-modal dialog"
    },
    "CaptureFrame": {
      "use": "CaptureFrame",
      "import": "import { CaptureFrame } from \"@/components/opc/capture-frame\"",
      "custom": true,
      "notes": "frame around vendor capture SDK"
    },
    "ActiveFilters": {
      "use": "ActiveFilters",
      "import": "import { ActiveFilters } from \"@/components/opc/active-filters\"",
      "custom": true,
      "notes": "chips row + clear + result"
    },
    "MenuAnchor": {
      "use": "MenuAnchor",
      "import": "import { MenuAnchor } from \"@/components/opc/menu-anchor\"",
      "custom": true,
      "notes": "positions a Menu"
    },
    "OnboardingStep": {
      "use": "OnboardingStep",
      "import": "import { OnboardingStep } from \"@/components/opc/onboarding-step\"",
      "custom": true,
      "notes": "recipe"
    },
    "HelpSheet": {
      "use": "HelpSheet",
      "import": "import { HelpSheet } from \"@/components/opc/help-sheet\"",
      "custom": true,
      "notes": "recipe"
    },
    "ListToolbar": {
      "use": "ListToolbar",
      "import": "import { ListToolbar } from \"@/components/opc/list-toolbar\"",
      "custom": true,
      "notes": "recipe"
    },
    "FilterPanel": {
      "use": "FilterPanel",
      "import": "import { FilterPanel } from \"@/components/opc/filter-panel\"",
      "custom": true,
      "notes": "recipe"
    },
    "Skeleton": {
      "use": "Skeleton",
      "import": "import { Skeleton } from \"@/components/ui/skeleton\"",
      "variants": {
        "line": {
          "className": "h-4"
        },
        "title": {
          "className": "h-7"
        },
        "figure": {
          "className": "h-14"
        },
        "block": {
          "className": "h-24 rounded-md"
        },
        "bar": {
          "className": "h-5 w-full rounded-md"
        },
        "row": {
          "className": "h-[72px] w-full rounded-2xl"
        }
      }
    },
    "LoadingNote": {
      "use": "LoadingNote",
      "import": "import { LoadingNote } from \"@/components/opc/loading-note\"",
      "custom": true,
      "notes": "'Đang tải… · số liệu trước đó hh:mm'"
    },
    "DocumentPreview": {
      "use": "DocumentPreview",
      "import": "import { DocumentPreview } from \"@/components/opc/document-preview\"",
      "custom": true,
      "notes": "paper-like e-invoice preview"
    },
    "Timeline": {
      "use": "Timeline",
      "import": "import { Timeline } from \"@/components/opc/timeline\"",
      "custom": true,
      "notes": "order/invoice history"
    },
    "SectionNav": {
      "use": "nav with Link items (aria-current)",
      "import": "import { Link } from \"@tanstack/react-router\"",
      "notes": "one route per item; feature switches filter items",
      "variants": {
        "wrap": {
          "className": "flex-wrap",
          "note": "short lists: wrap instead of scrolling on phone"
        }
      }
    },
    "DestinationList": {
      "use": "DestinationList",
      "import": "import { DestinationList } from \"@/components/opc/destination-list\"",
      "custom": true,
      "notes": "phone Thêm sheet / settings index"
    },
    "ApprovalList": {
      "use": "ApprovalList",
      "import": "import { ApprovalList } from \"@/components/opc/approval-list\"",
      "custom": true,
      "notes": "approval inbox list"
    },
    "ApprovalCard": {
      "use": "ApprovalCard",
      "import": "import { ApprovalCard } from \"@/components/opc/approval-card\"",
      "custom": true,
      "notes": "evidence + consequence before approve; audit on action"
    },
    "SidePanel": {
      "use": "Sheet side=right (desktop) / Drawer (phone)",
      "import": "import { Sheet, SheetContent } from \"@/components/ui/sheet\"",
      "variants": {
        "wide": {
          "className": "sm:max-w-[560px]"
        },
        "docked": {
          "note": "render inline in a 3-column shell"
        }
      }
    },
    "CommandPalette": {
      "use": "CommandDialog",
      "import": "import { CommandDialog, CommandInput, CommandList, CommandGroup, CommandItem } from \"@/components/ui/command\"",
      "notes": "⌘K and '/'; groups Đơn · Hành động · Đi tới"
    },
    "Toast": {
      "use": "toast() from sonner",
      "import": "import { toast } from \"sonner\"",
      "variants": {
        "err": {
          "note": "duration: Infinity"
        },
        "pend": {
          "note": "icon on truth-hatch"
        },
        "ok": {
          "note": "icon on truth-ok"
        },
        "undo": {
          "note": "toast(text, { action: { label: \"Hoàn tác\", onClick } }), duration 6000"
        }
      }
    },
    "ToastRegion": {
      "use": "<Toaster position=\"bottom-center\"/>",
      "import": "import { Toaster } from \"@/components/ui/sonner\"",
      "note": "dark pill (bg-panel); pend/ok icons use truth colours; undo = toast(..., {action:{label:\"Hoàn tác\"}}); hide while phone payment sheet is open"
    },
    "Checkbox": {
      "use": "Checkbox",
      "import": "import { Checkbox } from \"@/components/ui/checkbox\""
    },
    "Breadcrumb": {
      "use": "Breadcrumb",
      "import": "import { Breadcrumb } from \"@/components/ui/breadcrumb\""
    },
    "SyncStatus": {
