      "notes": "ZNS template preview"
    },
    "TextSizePicker": {
      "use": "TextSizePicker",
      "import": "import { TextSizePicker } from \"@/components/opc/text-size-picker\"",
      "custom": true,
      "notes": "display pref"
    },
    "TodayFigure": {
      "use": "<TodayFigure/> (opc)",
      "import": "import { TodayFigure } from \"@/components/opc/today-figure\"",
      "note": "plain region, no Card chrome; fig = text-[72px] font-bold tracking-[-.045em] tabular-nums; ₫ via <Cur/>"
    },
    "DayColumns": {
      "use": "<DayColumns days={7}/> (opc, CSS grid)",
      "import": "import { DayColumns } from \"@/components/opc/day-columns\"",
      "note": "today bar bg-primary; others bg-neutral-fill; values via Tooltip (desktop) / Popover (touch); every bar has sr-only text"
    },
    "MoneyTruthBar": {
      "use": "<MoneyTruthBar ok pend cash/> (opc)",
      "import": "import { MoneyTruthBar } from \"@/components/opc/money-truth-bar\"",
      "note": "SIGNATURE. ok=bg-truth-ok solid · pend=bg-[image:var(--truth-hatch)] + dashed outline · cash=bg-truth-cash; pending legend item is a Link to the to-do",
      "variants": {
        "legend-only": {
          "note": "first run: explains the three colours, no bar"
        }
      }
    },
    "ConnectionPill": {
      "use": "Badge variant=\"outline\" + Tooltip",
      "import": "import { Badge } from \"@/components/ui/badge\"",
      "variants": {
        "err": {
          "className": "bg-err-soft text-err-ink border-err/35"
        },
        "off": {
          "note": "device offline = pending tone"
        }
      },
      "note": "ONE pill for all connections; on touch open Popover instead of Tooltip"
    },
    "OffLabel": {
      "use": "span",
      "note": "hollow dot + ink-3 text"
    },
    "CountBadge": {
      "use": "Badge variant=\"secondary\"",
      "import": "import { Badge } from \"@/components/ui/badge\"",
      "className": "rounded-full"
    },
    "TextLink": {
      "use": "Button variant=\"link\"",
      "import": "import { Button } from \"@/components/ui/button\"",
      "className": "text-act-ink min-h-11"
    },
    "Subline": {
      "use": "p",
      "className": "text-base text-ink-3"
    },
    "Figure": {
      "use": "span",
      "className": "text-4xl font-bold tracking-tight tabular-nums"
    },
    "TodoList": {
      "use": "<ol> of rows + Button",
      "import": "import { Button } from \"@/components/ui/button\"",
      "note": "row--now: bg-act-soft + Button variant=default; others Button variant=outline; --done: check icon in ok-soft circle; max 3 + \"n việc không gấp\" link"
    },
    "OrderRows": {
      "use": "<ul> of <Link> rows (NOT <Table>)",
      "note": "who (name + code·channel·time) | StatusSign | amount text-lg font-semibold; two-line on phone and with large text ≤1180px"
    },
    "DebtList": {
      "use": "<ul> key/value rows",
      "note": "hairline between rows"
    },
    "TileGrid": {
      "use": "div grid auto-fill minmax(196px,1fr)",
      "variants": {
        "few": {
          "note": "2-up grid for a small catalogue"
        }
      }
    },
    "ProductTile": {
      "use": "<button> (opc ProductTile)",
      "import": "import { ProductTile } from \"@/components/opc/product-tile\"",
      "variants": {
        "incart": {
          "className": "bg-act-soft border-act ring-1 ring-act"
        },
        "justadded": {
          "note": "one-shot scale pop 320ms spring; respect prefers-reduced-motion"
        },
        "big": {
          "note": "idle hairline / in-cart raised; còn · đã giữ"
        }
      },
      "note": "text-first; photo slot when owner adds one; phone = row with 44px round add button"
    },
    "OrderLine": {
      "use": "li grid + QuantityStepper",
      "note": "amount text-lg font-bold; calc text-sm ink-2"
    },
    "OrderEmpty": {
      "use": "EmptyState (centered)",
      "note": "\"Chưa có món nào\" + kbd hint; Thu tiền button stays disabled with reason"
    },
    "QrCard": {
      "use": "figure + img",
      "note": "QR 196px on white, amount 36px bold below"
    },
    "PaymentSteps": {
      "use": "<ol aria-label> with aria-current=\"step\"",
      "import": "import { PaymentSteps } from \"@/components/opc/payment-steps\"",
      "variants": {
        "now": {
          "className": "dot bg-primary ring-6 ring-act-ring (pulse)"
        },
        "pendnow": {
          "className": "dot bg-[image:var(--truth-hatch)] border-dashed border-truth-pend"
        },
        "oknow": {
          "className": "dot bg-truth-ok text-white"
        },
        "done": {
          "className": "dot bg-ok-soft text-ok"
        },
        "next": {
          "className": "dot border-dashed border-line-quiet"
        }
      }
    },
    "WaitBar": {
      "use": "div role=status aria-live=polite",
      "note": "spinner + \"OPC tự chuyển bước khi ngân hàng báo — không cần bấm\""
    },
    "MoneyArrived": {
      "use": "<MoneyArrived state=\"pend|ok\"/> (opc)",
      "import": "import { MoneyArrived } from \"@/components/opc/money-arrived\"",
      "note": "replaces QrCard when the bank reports; role=status aria-live=assertive; enter 480ms spring; ok draws the check (stroke-dashoffset); optional sound/vibration (setting)",
      "variants": {
        "ok": {
          "note": "verified: green, check draws in"
        }
      }
    },
    "InlineNote": {
      "use": "Alert (subtle, no border)",
