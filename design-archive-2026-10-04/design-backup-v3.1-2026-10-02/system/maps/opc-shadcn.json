{
 "library": "shadcn/ui (OPC extension)",
 "platform": "web-react",
 "docs": "https://ui.shadcn.com/docs/components",
 "extends": "references/component-maps/shadcn.json",
 "components": {
  "Button": {
   "use": "Button",
   "import": "import { Button } from \"@/components/ui/button\"",
   "variants": {
    "_default": {
     "variant": "outline"
    },
    "act": {
     "variant": "default",
     "note": "yellow --act; ONE per view"
    },
    "quiet": {
     "variant": "outline",
     "className": "border-line-quiet"
    },
    "danger": {
     "variant": "outline",
     "className": "text-err border-err"
    },
    "wrap": {
     "variant": "outline",
     "className": "h-auto whitespace-normal text-left font-body font-medium"
    },
    "block": {
     "className": "w-full"
    }
   },
   "states": {
    "disabled": {
     "disabled": true,
     "note": "dashed border, never opacity only"
    },
    "aria-busy": {
     "disabled": true,
     "note": "spinner after label"
    }
   },
   "parts": {
    "icon": "lucide icon child",
    "kbd": "<Kbd> child"
   },
   "notes": "add variant act to buttonVariants (cva); min-h from --target via theme"
  },
  "IconButton": {
   "use": "Button size=icon",
   "import": "import { Button } from \"@/components/ui/button\"",
   "variants": {
    "outline": {
     "variant": "outline"
    },
    "_default": {
     "variant": "ghost"
    }
   },
   "parts": {
    "badge": "absolute count badge (aria-hidden; count in aria-label)"
   }
  },
  "Icon": {
   "use": "lucide-react icon",
   "import": "import { House, Store, ReceiptText, … } from \"lucide-react\"",
   "notes": "sprite ids map 1:1 to lucide icons; strokeWidth 2.4, square caps; size 22/18/26",
   "variants": {
    "s": {
     "size": 18
    },
    "l": {
     "size": 26
    },
    "_default": {
     "size": 22
    }
   }
  },
  "Kbd": {
   "use": "Kbd",
   "import": "import { Kbd } from \"@/components/ui/kbd\"",
   "notes": "shadcn Kbd (2025) or a <kbd> with tokens"
  },
  "SearchField": {
   "use": "Input with leading icon",
   "import": "import { Input } from \"@/components/ui/input\"",
   "variants": {
    "strong": {
     "className": "border-line-strong"
    }
   },
   "parts": {
    "input": "Input type=search"
   }
  },
  "Card": {
   "use": "Card",
   "import": "import { Card } from \"@/components/ui/card\"",
   "variants": {
    "tight": {
     "className": "p-4"
    }
